# Template for backend/.env — copy to .env and fill in real values.
#   cp .env.example .env
# .env is gitignored; never commit real keys.

# ============================================================================
# REQUIRED FIELDS (app will fail to start without these)
# ============================================================================

# Database connection string (required)
# Example for local dev: sqlite:///./local_dev.db
# Example for MySQL: mysql+pymysql://user:password@localhost:3306/trippilot
DATABASE_URL=mysql+pymysql://trippilot_user:PASSWORD@localhost:3306/trippilot

# JWT secret key for signing tokens (required)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here

# ============================================================================
# JWT CONFIGURATION (optional, has defaults)
# ============================================================================

# JWT signing algorithm
ALGORITHM=HS256

# Access token expiration in minutes (default: 1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ============================================================================
# AI & EXTERNAL APIs (optional)
# ============================================================================

# Gemini API — itinerary/lead/voucher AI generation
GEMINI_API_KEY=

# Google Places API (New) — resolves hotels/places to real Google Maps photos.
# Key's project needs Places API (New) enabled + billing linked.
GOOGLE_PLACES_API_KEY=

# Legacy Google Custom Search (API discontinued for new customers; only used as
# a fallback key if GOOGLE_PLACES_API_KEY is empty)
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# OpenAI (not currently used)
OPENAI_API_KEY=

# ============================================================================
# Meta / WhatsApp / Instagram (optional)
# ============================================================================

# Meta access token for WhatsApp/Instagram webhooks
META_ACCESS_TOKEN=

# Meta verify token for webhook validation
META_VERIFY_TOKEN=

# WhatsApp Business Phone Number ID
WHATSAPP_PHONE_NUMBER_ID=

# Instagram Page ID
INSTAGRAM_PAGE_ID=

# Meta API version (default: v20.0)
META_API_VERSION=v20.0
